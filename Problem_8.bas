10 Let NUM$ = "": Let TEMP$ = "": Let N = 0: Let PROD# = 1: Let MAXPROD# = 0: BESTSEQ$ = ""
15 Rem NUM$=String version of 1000 digit integer | TEMP$=storage for READ function | N=Temp store for individual integers
19 Rem Load data
20 Dim STORE#(13): Rem Array to store current working integers
30 For I = 1 To 20
    40 Read TEMP$
    50 Let NUM$ = NUM$ + TEMP$
60 Next I
70 If Len(NUM$) <> 1000 Then GoTo 1500


99 Rem Compare Products
100 Let J = 1
110 Do While J < 988
    120 Let DIV0 = 0
    130 GoSub 400: Rem grab some numbers & check for zeros
    140 If DIV0 = 1 Then GoTo 230: Rem Skip this batch because it contains a 0
    150 Let PROD# = 1
    160 For K = 1 To 13
        170 Let PROD# = PROD# * STORE#(K)
    180 Next K
    190 If PROD# > MAXPROD# Then
        200 Let MAXPROD# = PROD#
        210 Let BESTSEQ$ = Mid$(NUM$, J, 13)
    220 End If
    230 Let J = J + 1
240 Loop

299 Rem Print results

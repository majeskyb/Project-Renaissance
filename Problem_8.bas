1 Cls
5 Rem Largest Product in a Series
10 Let NUM$ = "": Let TEMP$ = "": Let MAXPROD# = 0: Let BESTSEQ$ = ""
15 Rem NUM$ = 1000 digit string | TEMP$ = storage for READ

20 Dim STORE#(13): Rem Simple array to hold current 13 digits

30 For I = 1 To 20
    40 Read TEMP$
    50 Let NUM$ = NUM$ + TEMP$
60 Next I

70 If Len(NUM$) <> 1000 Then GoTo 1500

99 Rem Compare Products
100 Let J = 1
102 Do While J <= 988
    105 Let DIV0 = 0
    110 GoSub 400: Rem grab 13 numbers and check for zeros

    115 If DIV0 = 1 Then GoTo 200: Rem Skip this batch (J was advanced in subroutine)

    120 Let PROD# = 1
    130 For K = 1 To 13
        140 Let PROD# = PROD# * STORE#(K)
    150 Next K

    160 If PROD# > MAXPROD# Then
        Let MAXPROD# = PROD#
        Let BESTSEQ$ = Mid$(NUM$, J, 13)
    End If

    200 Let J = J + 1: Rem Move to next position normally
210 Loop

250 Rem Print Results
300 Print "Largest 13-Digit Product:"
310 Print MAXPROD#
320 Print "Winning Sequence:"
330 Print BESTSEQ$
340 End

400 Rem --- Subroutine: Fetch Digits & Skip Zeros ---
405 For X = 1 To 13
    410 Let N = Val(Mid$(NUM$, J + X - 1, 1))
    415 If N = 0 Then
        Rem Fast-forward J past the zero, subtract 1 because line 200 adds 1
        Let J = J + X - 1
        Let DIV0 = 1
        GoTo 440
    End If
    420 Let STORE#(X) = N
430 Next X
440 Return


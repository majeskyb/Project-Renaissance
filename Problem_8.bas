310 Print "Winning Sequence: "; BESTSEQ$
320 End





400 Rem Subroutine to grab digits and skip zeros
405 For X = 1 To 13
    410 Let N = Val(Mid$(NUM$, J + X - 1, 1)): Rem J is loop variable above for calculating products, J is absolute position within the data
    415 If N = 0 Then
        416 Let J = J + X - 1
        417 Let DIV0 = 1
        418 GoTo 440: Rem If 0 is detected, advance through it and exit the subroutine
    419 End If
    420 Let STORE#(X) = N
430 Next X
440 Return



